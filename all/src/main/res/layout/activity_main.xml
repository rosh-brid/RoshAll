<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:id="@+id/pusat"
     tools:context=".Main">

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:orientation="vertical">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@color/bg">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/nav"
                 android:layout_marginStart="10dp"
                 android:id="@+id/nav"
                 android:layout_gravity="center_vertical|start" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:layout_gravity="center">

                <ImageView
                     android:layout_height="35dp"
                     android:layout_width="35dp"
                     android:src="@drawable/ikon"
                     android:layout_marginEnd="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="18sp"
                     android:fontFamily="@font/alkdots"
                     android:text="@string/AppName"
                     android:textStyle="bold" />

            </LinearLayout>

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/github"
                 android:layout_marginEnd="10dp"
                 android:id="@+id/github"
                 android:layout_gravity="center_vertical|end" />

        </FrameLayout>

        <GridLayout
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:id="@+id/coba"
             android:columnCount="3"
             android:layout_gravity="center_horizontal">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:padding="10dp"
                 android:layout_margin="5dp"
                 android:orientation="vertical"
                 android:id="@+id/berkas">

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/folder_search"
                     android:layout_margin="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="80dp"
                     android:gravity="center"
                     android:layout_margin="3dp"
                     android:text="Explorer" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:padding="10dp"
                 android:layout_margin="5dp"
                 android:orientation="vertical"
                 android:id="@+id/terminal">

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/terminal"
                     android:layout_margin="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="80dp"
                     android:gravity="center"
                     android:layout_margin="3dp"
                     android:text="Terminal" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:padding="10dp"
                 android:layout_margin="5dp"
                 android:orientation="vertical"
                 android:id="@+id/code">

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/code"
                     android:layout_margin="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="80dp"
                     android:gravity="center"
                     android:layout_margin="3dp"
                     android:text="Code" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:padding="10dp"
                 android:layout_margin="5dp"
                 android:orientation="vertical"
                 android:id="@+id/video">

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/play_video"
                     android:layout_margin="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="80dp"
                     android:gravity="center"
                     android:layout_margin="3dp"
                     android:text="Video" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:padding="10dp"
                 android:layout_margin="5dp"
                 android:orientation="vertical"
                 android:id="@+id/gambar">

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/image_search"
                     android:layout_margin="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="80dp"
                     android:gravity="center"
                     android:layout_margin="3dp"
                     android:text="Images" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:padding="10dp"
                 android:layout_margin="5dp"
                 android:orientation="vertical"
                 android:id="@+id/musik">

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/music_icon"
                     android:layout_margin="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="80dp"
                     android:gravity="center"
                     android:layout_margin="3dp"
                     android:text="Music" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:padding="10dp"
                 android:layout_margin="5dp"
                 android:orientation="vertical"
                 android:id="@+id/browser">

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/browser"
                     android:layout_margin="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="80dp"
                     android:gravity="center"
                     android:layout_margin="3dp"
                     android:text="Browser" />

            </LinearLayout>

        </GridLayout>

    </LinearLayout>

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="310dp"
         android:background="@color/bg"
         android:orientation="vertical"
         android:layout_gravity="start">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@drawable/bg_card"
             android:layout_margin="10dp">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/exit"
                 android:layout_marginStart="10dp"
                 android:id="@+id/keluar"
                 android:layout_gravity="center_vertical|start" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:layout_gravity="center"
                 android:id="@+id/tema">

                <ImageView
                     android:layout_height="20dp"
                     android:layout_width="20dp"
                     android:layout_marginEnd="5dp"
                     android:src="@drawable/sun"
                     android:id="@+id/gambar_tema" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:text="Themes"
                     android:id="@+id/nama_tema"
                     android:textStyle="italic|bold" />

            </LinearLayout>

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/close"
                 android:layout_marginEnd="10dp"
                 android:id="@+id/tutup"
                 android:layout_gravity="center_vertical|end" />

        </FrameLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:padding="5dp"
             android:layout_margin="5dp"
             android:orientation="horizontal"
             android:id="@+id/jaringan">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/lte"
                 android:layout_margin="5dp" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:text="Network Settings" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:padding="5dp"
             android:layout_margin="5dp"
             android:orientation="horizontal"
             android:id="@+id/font">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/font"
                 android:layout_margin="5dp" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:text="Font" />

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>