<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     tools:context=".Code"
     android:id="@+id/pusat">

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:orientation="vertical">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@color/bg">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/nav"
                 android:layout_marginStart="10dp"
                 android:id="@+id/nav"
                 android:layout_gravity="start|center_vertical" />

            <FrameLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_marginEnd="10dp"
                 android:id="@+id/simpan"
                 android:layout_gravity="end|center_vertical">

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/save" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="25sp"
                     android:textColor="#ffaaff"
                     android:id="@+id/tanda_simpan"
                     android:layout_gravity="end"
                     android:text="*" />

            </FrameLayout>

        </FrameLayout>

        <HorizontalScrollView
             android:layout_height="40dp"
             android:layout_width="match_parent">

            <GridLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:orientation="horizontal"
                 android:id="@+id/tempat_nama">

            </GridLayout>

        </HorizontalScrollView>

        <lib.widget.codeeditor.CodeEditor
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:id="@+id/editor" />

    </LinearLayout>

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="310dp"
         android:background="@color/bg"
         android:orientation="vertical"
         android:layout_gravity="start ">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@drawable/bg_card"
             android:layout_margin="10dp">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/exit"
                 android:layout_marginStart="10dp"
                 android:id="@+id/keluar"
                 android:layout_gravity="start|center_vertical" />

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/close"
                 android:layout_marginEnd="10dp"
                 android:id="@+id/tutup"
                 android:layout_gravity="end|center_vertical" />

        </FrameLayout>

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:layout_margin="5dp"
             android:orientation="horizontal">

            <LinearLayout
                 android:layout_height="match_parent"
                 android:layout_width="50dp"
                 android:background="@color/pop"
                 android:orientation="vertical"
                 android:layout_marginTop="10dp">

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/folder_search"
                     android:layout_margin="10dp"
                     android:id="@+id/menu_folder" />

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:src="@drawable/plugin"
                     android:layout_margin="10dp"
                     android:id="@+id/menu_plugin" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:layout_marginTop="10dp"
                 android:id="@+id/tempat_menu">

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>