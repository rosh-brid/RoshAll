<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:id="@+id/pusat">

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:id="@+id/root_utama">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@color/bg">

        </FrameLayout>

        <io.github.rosemoe.sora.widget.CodeEditor
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:layout_margin="5dp"
             android:id="@+id/kode" />

    </LinearLayout>

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="310dp"
         android:background="@color/bg"
         android:orientation="horizontal"
         android:id="@+id/root_drawer"
         android:layout_gravity="start">

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="50dp"
             android:gravity="center_horizontal"
             android:orientation="vertical">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:layout_marginBottom="40dp"
                 android:src="@drawable/keluar"
                 android:layout_marginTop="10dp"
                 android:id="@+id/keluar" />

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:layout_marginBottom="10dp"
                 android:src="@drawable/ikon_pilih_folder"
                 android:layout_marginTop="10dp"
                 android:id="@+id/pilih_folder" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:orientation="vertical">

            <FrameLayout
                 android:layout_height="50dp"
                 android:layout_width="match_parent">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:fontFamily="@font/alkdots"
                     android:layout_gravity="center"
                     android:textStyle="italic|bold"
                     android:id="@+id/aksi"
                     android:text="Action" />

                <ImageView
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:layout_marginEnd="10dp"
                     android:src="@drawable/tutup"
                     android:id="@+id/tutup"
                     android:layout_gravity="center_vertical|end" />

            </FrameLayout>

            <LinearLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:id="@+id/tempat_alat">

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>