<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:id="@+id/pusat">

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:id="@+id/root_utama">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@color/bg">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/nav"
                 android:layout_marginStart="10dp"
                 android:id="@+id/nav"
                 android:layout_gravity="center_vertical|start" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:layout_gravity="center">

                <ImageView
                     android:layout_height="35dp"
                     android:layout_width="35dp"
                     android:layout_marginEnd="5dp"
                     android:src="@drawable/folder" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="18sp"
                     android:fontFamily="@font/alkdots"
                     android:textStyle="bold"
                     android:text="@string/app_berkas" />

            </LinearLayout>

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:layout_marginEnd="10dp"
                 android:src="@drawable/lainya"
                 android:layout_gravity="end|center_vertical"
                 android:id="@+id/opsi_lainya" />

        </FrameLayout>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_margin="3dp"
             android:textSize="16sp"
             android:textIsSelectable="true"
             android:text="/"
             android:textStyle="italic|bold"
             android:id="@+id/jalur" />

        <ScrollView
             android:layout_height="match_parent"
             android:layout_width="match_parent">

            <GridLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_gravity="center_horizontal"
                 android:columnCount="3"
                 android:id="@+id/tempat_folder">

            </GridLayout>

        </ScrollView>

    </LinearLayout>

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="310dp"
         android:background="@color/bg"
         android:orientation="vertical"
         android:id="@+id/root_drawer"
         android:layout_gravity="start">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@drawable/bg_kotak"
             android:layout_margin="10dp"
             android:backgroundTint="@color/ungu">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/keluar"
                 android:layout_marginStart="10dp"
                 android:id="@+id/keluar"
                 android:layout_gravity="center_vertical|start" />

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/tutup"
                 android:layout_marginEnd="10dp"
                 android:id="@+id/tutup"
                 android:layout_gravity="center_vertical|end" />

        </FrameLayout>

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:orientation="vertical">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="10dp"
                 android:gravity="center"
                 android:textSize="16sp"
                 android:textColor="@color/ungu"
                 android:layout_marginTop="20dp"
                 android:textStyle="bold|italic"
                 android:text="~~ LIST DIRECTORY ~~" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="@drawable/bg_kotak"
                 android:layout_margin="15dp"
                 android:padding="10dp"
                 android:orientation="horizontal"
                 android:backgroundTint="@color/ui_biru"
                 android:id="@+id/memo_app">

                <ImageView
                     android:layout_height="50dp"
                     android:layout_width="50dp"
                     android:src="@drawable/ikon"
                     android:layout_marginEnd="10dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="16sp"
                     android:text="Application Storage"
                     android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="@drawable/bg_kotak"
                 android:layout_margin="15dp"
                 android:padding="10dp"
                 android:orientation="horizontal"
                 android:backgroundTint="@color/ui_biru"
                 android:id="@+id/memo_apk">

                <ImageView
                     android:layout_height="50dp"
                     android:layout_width="50dp"
                     android:src="@drawable/android"
                     android:layout_marginEnd="10dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="16sp"
                     android:text="Internal Storage"
                     android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="@drawable/bg_kotak"
                 android:layout_margin="15dp"
                 android:padding="10dp"
                 android:orientation="horizontal"
                 android:backgroundTint="@color/ui_biru"
                 android:id="@+id/memo_sd">

                <ImageView
                     android:layout_height="50dp"
                     android:layout_width="50dp"
                     android:src="@drawable/sd_card"
                     android:layout_marginEnd="10dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="16sp"
                     android:text="External Storage"
                     android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="@drawable/bg_kotak"
                 android:layout_margin="15dp"
                 android:padding="10dp"
                 android:orientation="horizontal"
                 android:backgroundTint="@color/ui_biru"
                 android:id="@+id/memo_usb">

                <ImageView
                     android:layout_height="50dp"
                     android:layout_width="50dp"
                     android:src="@drawable/usb"
                     android:layout_marginEnd="10dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="16sp"
                     android:text="USB Storage"
                     android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>