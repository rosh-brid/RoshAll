<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:id="@+id/pusat">

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:id="@+id/root_utama">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@color/bg">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:src="@drawable/nav"
                 android:layout_marginStart="10dp"
                 android:id="@+id/nav"
                 android:layout_gravity="center_vertical|start" />

            <EditText
                 android:layout_height="40dp"
                 android:layout_width="200dp"
                 android:layout_marginEnd="10dp"
                 android:gravity="center_vertical"
                 android:textSize="14sp"
                 android:fontFamily="@font/nateli"
                 android:textColor="@color/tulisan"
                 android:inputType="textWebEditText"
                 android:textStyle="italic"
                 android:layout_gravity="center"
                 android:id="@+id/link" />

            <ImageView
                 android:layout_height="40dp"
                 android:layout_width="40dp"
                 android:layout_marginEnd="10dp"
                 android:src="@drawable/kaca_pembesar"
                 android:layout_gravity="end|center_vertical"
                 android:id="@+id/cari" />

        </FrameLayout>

        <LinearLayout
             android:layout_height="5dp"
             android:layout_width="match_parent"
             android:background="@color/bg_pop"
             android:id="@+id/root_proses">

            <LinearLayout
                 android:layout_height="match_parent"
                 android:layout_width="wrap_content"
                 android:background="#00ff00"
                 android:id="@+id/anak_proses">

            </LinearLayout>

        </LinearLayout>

        <android.webkit.WebView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:layout_margin="5dp"
             android:id="@+id/web">

        </android.webkit.WebView>

    </LinearLayout>

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="310dp"
         android:background="@color/bg"
         android:orientation="vertical"
         android:id="@+id/root_drawer"
         android:layout_gravity="start">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@drawable/bg_kotak"
             android:layout_margin="10dp"
             android:backgroundTint="@color/ungu">

        </FrameLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>