<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:id="@+id/pusat">

    <FrameLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:id="@+id/root_utama">

        <rosh.lib.widget.TerminalView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:id="@+id/terminal" />

    </FrameLayout>

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="310dp"
         android:background="#333333"
         android:orientation="vertical"
         android:id="@+id/root_drawer"
         android:layout_gravity="start">

        <FrameLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:background="@drawable/bg_kotak"
             android:layout_margin="10dp"
             android:backgroundTint="#773377">

            <TextView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:textSize="18sp"
                 android:textColor="#773377"
                 android:layout_marginStart="10dp"
                 android:layout_gravity="center_vertical|start"
                 android:gravity="center"
                 android:background="@drawable/bg_kotak"
                 android:fontFamily="@font/extrasquare"
                 android:backgroundTint="#333333"
                 android:id="@+id/keluar"
                 android:textStyle="bold"
                 android:text="X" />

            <Switch
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="16sp"
                 android:textStyle="italic|bold"
                 android:id="@+id/mode"
                 android:text="Shell"
                 android:layout_gravity="center" />

        </FrameLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>